@page "/cadastrar"

<h1>Cadastro de Cliente</h1>

<label>Nome</label>
<br />
<input type="text" class="form-control w-25" @bind="nome" />
<br />
<label>email</label>
<br />
<input type="text" class="form-control w-25" @bind="email" />
<br />
<label>telefone</label>
<br />
