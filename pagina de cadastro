@using MySql.Data.MySqlClient
@page "/"

<h1>@titulo</h1>

<label>Nome</label>
<br />
<input type="text" class="form-control w-25" @bind="nome" />
<br />
<label>email</label>
<br />
<input type="text" class="form-control w-25" @bind="email" />
<br />
<label>telefone</label>
<br />
<input type="text" class="form-control w-25" @bind="telefone" />
<br />

<button class="btn btn-outline-primary" @onclick="Cadastro">@btnCadastrar</button>
<button class="btn btn-outline-secondary @isVisibleBtnCancelar" @onclick="Cancelar">Cancelar</button>

<br />
<br />
<p>Mensagem: @mensagem</p>

<br />

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>email</th>
            <th>telefone</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Cliente cliente in lista)
        {
            <tr>
                <td>@cliente.id</td>
                <td>@cliente.nome</td>
                <td>@cliente.email</td>
                <td>@cliente.telefone</td>
                <td>
                    <button class="btn btn-outline-danger" @onclick="() => Excluir(cliente.id)">Excluir</button>
                    <button class="btn btn-outline-warning" @onclick="() => Editar(cliente.id)">Alterar</button>
                </td>

            </tr>
        }

    </tbody>
</table>

@code {

    int id;
    string nome;
    string email;
    string telefone;
    string mensagem;
    string btnCadastrar = "Cadastrar";
    string isVisibleBtnCancelar = "invisible";
    string titulo = "Cadastro de cliente";

    List<Cliente> lista = new List<Cliente>();

    protected override void OnInitialized()
    {
        ListarClientes();
    }

    void Cadastro()
    {
        //Novo registro
        if (btnCadastrar == "Cadastrar")
        {
            SalvarNoBanco(nome, email, telefone);
        }

        else
        {
            //Editar registro
            AlterarNoBanco(id, nome,email, telefone);
        }

        ListarClientes();
        LimparCampos();
    }

    void SalvarNoBanco(string nome, string email, string telefone)
    {
        try
        {
            //servidor - nome do banco - usuario - senha
            string conexao = "server=localhost;database=cadastro_cliente;user=root;password=root";

            using MySqlConnection conn = new MySqlConnection(conexao);
            conn.Open();

            string sql = "INSERT INTO CLIENTE (NOME, EMAIL, TELEFONE) VALUES (@nome, @email, @telefone)";

            using MySqlCommand cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@nome", nome);
            cmd.Parameters.AddWithValue("@email", email);
            cmd.Parameters.AddWithValue("@telefone", telefone);

            cmd.ExecuteNonQuery();

            mensagem = "Cliente cadastrado com sucesso!";
        }

        catch (Exception ex)
        {
            mensagem = "Erro ao cadastrar cliente: " + ex.Message;
        }

    }

    void AlterarNoBanco(int id, string nome, string email, string telefone)
    {
        string conexao = "server=localhost;database=cadastro_cliente;user=root;password=root";

        using MySqlConnection conn = new MySqlConnection(conexao);
        conn.Open();

        string sql = "UPDATE CLIENTE SET NOME = @NOME, EMAIL = @email, TELEFONE = @telefone WHERE ID = @id";

        using MySqlCommand cmd = new MySqlCommand(sql, conn);
        cmd.Parameters.AddWithValue("@id", id);
        cmd.Parameters.AddWithValue("@nome", nome);
        cmd.Parameters.AddWithValue("@email", email);
        cmd.Parameters.AddWithValue("@telefone", telefone);

        cmd.ExecuteNonQuery();

        mensagem = "Cliente alterado com sucesso!";
    }

    public class Cliente()
    {
        public int id { get; set; }
        public string nome { get; set; }
        public string email { get; set; }
        public string telefone { get; set; }
    }

    void ListarClientes()
    {
        string conexao = "server=localhost;database=cadastro_cliente;user=root;password=root";

        using MySqlConnection conn = new MySqlConnection(conexao);
        conn.Open();

        string sql = "SELECT * FROM CLIENTE";

        using MySqlCommand cmd = new MySqlCommand(sql, conn);

        using MySqlDataReader reader = cmd.ExecuteReader();

        lista.Clear();

        while (reader.Read())
        {
            Cliente cliente = new Cliente();

            cliente.id = reader.GetInt32("id");
            cliente.nome = reader.GetString("nome");
            cliente.email = reader.GetString("email");
            cliente.telefone = reader.GetString("telefone");

            lista.Add(cliente);
        }
    }

    void Excluir(int id)
    {
        // Implementação para excluir cliente
        string conexao = "server=localhost;database=cadastro_cliente;user=root;password=root";

        using MySqlConnection conn = new MySqlConnection(conexao);
        conn.Open();

        string sql = "DELETE FROM CLIENTE WHERE ID = @id";

        using MySqlCommand cmd = new MySqlCommand(sql, conn);
        cmd.Parameters.AddWithValue("@id", id);

        cmd.ExecuteNonQuery();

        mensagem = "Cliente excluido com sucesso!";

        ListarClientes();
    }

    void Editar(int id)
    {
        this.id = id;
        //carregar os dados id
        string conexao = "server=localhost;database=cadastro_cliente;user=root;password=root";

        using MySqlConnection conn = new MySqlConnection(conexao);
        conn.Open();

        string sql = "SELECT * FROM CLIENTE WHERE ID = @id";

        using MySqlCommand cmd = new MySqlCommand(sql, conn);
        cmd.Parameters.AddWithValue("@id",id);

        using MySqlDataReader reader = cmd.ExecuteReader();

        if (reader.Read())
        {
            nome = reader.GetString("nome");
            email = reader.GetString("email");
            telefone = reader.GetString("telefone");
        }

        // alterar nome dos botoes e titulo
        isVisibleBtnCancelar = "visible";
        titulo = "Alterar Cliente";
        btnCadastrar = "Alterar"; 
    }

    void LimparCampos()
    {
        nome = "";
        telefone = "";
        email = "";
    }

    void Cancelar()
    {
        LimparCampos();
        isVisibleBtnCancelar = "invisible";
        titulo = "Cadastro de Cliente";
        btnCadastrar = "Cadastrar";
    }

}
